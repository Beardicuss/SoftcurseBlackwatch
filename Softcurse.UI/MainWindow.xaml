<Window x:Class="Softcurse.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Softcurse.UI.ViewModels"
        xmlns:conv="clr-namespace:Softcurse.UI.Converters"
        Title="SOFTCURSE SENTINEL" Width="1280" Height="800"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="Consolas">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <conv:ThreatLevelToBrushConverter x:Key="ThreatBrush"/>
        <conv:ThreatLevelToStringConverter x:Key="ThreatString"/>
        <conv:ThreatScoreToStringConverter x:Key="ScoreString"/>
        <conv:ViewIndexToVisibilityConverter x:Key="ViewVis"/>
        <conv:ChartDataToGeometryConverter x:Key="ChartLine"/>
        <conv:ChartDataToFillGeometryConverter x:Key="ChartFill"/>
        <conv:LogLevelToBrushConverter x:Key="LogBrush"/>
        <conv:NavTagConverter x:Key="NavTag"/>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
    </Window.Resources>

    <Grid>
        <!-- Background Cyan Grid Overlay -->
        <Canvas IsHitTestVisible="False" Opacity="0.04">
            <Canvas.Background>
                <DrawingBrush TileMode="Tile" Viewport="0,0,40,40" ViewportUnits="Absolute">
                    <DrawingBrush.Drawing>
                        <GeometryDrawing>
                            <GeometryDrawing.Pen>
                                <Pen Brush="#00FFFF" Thickness="0.5"/>
                            </GeometryDrawing.Pen>
                            <GeometryDrawing.Geometry>
                                <GeometryGroup>
                                    <LineGeometry StartPoint="0,0" EndPoint="40,0"/>
                                    <LineGeometry StartPoint="0,0" EndPoint="0,40"/>
                                </GeometryGroup>
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                    </DrawingBrush.Drawing>
                </DrawingBrush>
            </Canvas.Background>
        </Canvas>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ═══════ SIDEBAR ═══════ -->
            <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <!-- Header -->
                    <StackPanel DockPanel.Dock="Top" Margin="0,24,0,24">
                        <TextBlock Text="SOFTCURSE" FontSize="20" FontWeight="Bold"
                                   Foreground="{StaticResource CyanBrush}"
                                   HorizontalAlignment="Center"
                                   Effect="{StaticResource CyanGlowStrong}"/>
                        <TextBlock Text="S E N T I N E L" FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        <Border Height="1" Margin="20,16,20,0" CornerRadius="1">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="Transparent" Offset="0"/>
                                    <GradientStop Color="#00FFFF" Offset="0.5"/>
                                    <GradientStop Color="Transparent" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                    </StackPanel>

                    <!-- Status at Bottom -->
                    <StackPanel DockPanel.Dock="Bottom" Margin="16,0,16,16">
                        <Border Height="1" Margin="0,0,0,12">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="Transparent" Offset="0"/>
                                    <GradientStop Color="#1A3A3A" Offset="0.5"/>
                                    <GradientStop Color="Transparent" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <TextBlock Text="{Binding StatusText}" FontSize="10"
                                   Foreground="{StaticResource CyanBrush}"
                                   TextWrapping="Wrap" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- Navigation -->
                    <StackPanel Margin="0,8,0,0">
                        <Button Content="▣ DASHBOARD" Style="{StaticResource NavButton}"
                                Tag="{Binding ActiveView, Converter={StaticResource NavTag}, ConverterParameter=0}"
                                Command="{Binding NavigateCommand}" CommandParameter="0"/>
                        <Button Content="⚠ THREATS" Style="{StaticResource NavButton}"
                                Tag="{Binding ActiveView, Converter={StaticResource NavTag}, ConverterParameter=1}"
                                Command="{Binding NavigateCommand}" CommandParameter="1"/>
                        <Button Content="◎ PROCESSES" Style="{StaticResource NavButton}"
                                Tag="{Binding ActiveView, Converter={StaticResource NavTag}, ConverterParameter=2}"
                                Command="{Binding NavigateCommand}" CommandParameter="2"/>
                        <Button Content="⇄ NETWORK" Style="{StaticResource NavButton}"
                                Tag="{Binding ActiveView, Converter={StaticResource NavTag}, ConverterParameter=3}"
                                Command="{Binding NavigateCommand}" CommandParameter="3"/>
                        <Button Content="▤ LOGS" Style="{StaticResource NavButton}"
                                Tag="{Binding ActiveView, Converter={StaticResource NavTag}, ConverterParameter=4}"
                                Command="{Binding NavigateCommand}" CommandParameter="4"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ═══════ MAIN CONTENT ═══════ -->
            <Grid Grid.Column="1" Margin="24">

                <!-- Logo Watermark Background — breathing opacity 30s cycle -->
                <Image x:Name="LogoWatermark" Source="Assets/logo-Photoroom.png"
                       Width="800" Height="800"
                       Opacity="0.04"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Stretch="Uniform" IsHitTestVisible="False"
                       CacheMode="BitmapCache">
                    <Image.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                     From="0.03" To="0.08"
                                                     Duration="0:0:15">
                                        <DoubleAnimation.EasingFunction>
                                            <CubicEase EasingMode="EaseInOut"/>
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Image.Triggers>
                </Image>

                <!-- ═══════ VIEW 0: DASHBOARD ═══════ -->
                <Grid Visibility="{Binding ActiveView, Converter={StaticResource ViewVis}, ConverterParameter=0}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <TextBlock Text="▣ DASHBOARD" Style="{StaticResource HeaderText}" Margin="0,0,0,20"/>

                    <!-- Stat Cards -->
                    <UniformGrid Grid.Row="1" Rows="1" Columns="4" Margin="0,0,0,20">
                        <!-- CPU -->
                        <Border Style="{StaticResource CardPanel}" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="CPU" Style="{StaticResource LabelText}"/>
                                <TextBlock Text="{Binding CpuUsage, StringFormat={}{0:F1}%}"
                                           Style="{StaticResource ValueText}"/>
                                <ProgressBar Value="{Binding CpuUsage}" Maximum="100"
                                             Style="{StaticResource CyberProgressBar}" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                        <!-- RAM -->
                        <Border Style="{StaticResource CardPanel}" Margin="4,0,4,0">
                            <StackPanel>
                                <TextBlock Text="MEMORY" Style="{StaticResource LabelText}"/>
                                <TextBlock Style="{StaticResource ValueText}">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0:F0} MB">
                                            <Binding Path="RamUsedMB"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                                <ProgressBar Value="{Binding RamUsage}" Maximum="100"
                                             Style="{StaticResource CyberProgressBar}" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                        <!-- Processes -->
                        <Border Style="{StaticResource CardPanel}" Margin="4,0,4,0">
                            <StackPanel>
                                <TextBlock Text="PROCESSES" Style="{StaticResource LabelText}"/>
                                <TextBlock Text="{Binding ProcessCount}"
                                           Style="{StaticResource ValueText}"/>
                            </StackPanel>
                        </Border>
                        <!-- Threats — Magenta accent -->
                        <Border Style="{StaticResource CardPanelMagenta}" Margin="8,0,0,0">
                            <StackPanel>
                                <TextBlock Text="THREATS" Foreground="{StaticResource MagentaBrush}"
                                           FontFamily="Consolas" FontSize="11"/>
                                <TextBlock Text="{Binding ThreatCount}" FontSize="28"
                                           FontFamily="Consolas" FontWeight="Bold"
                                           Foreground="{StaticResource MagentaBrush}"/>
                                <ProgressBar Value="{Binding ThreatCount}" Maximum="10"
                                             Style="{StaticResource MagentaProgressBar}" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- Charts -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- CPU Chart -->
                        <Border Grid.Column="0" Style="{StaticResource CardPanel}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="CPU USAGE HISTORY"
                                           Style="{StaticResource LabelText}" Margin="0,0,0,8"/>
                                <Viewbox Stretch="Fill">
                                    <Canvas Width="400" Height="80" ClipToBounds="True">
                                        <Path Data="{Binding CpuHistory, Converter={StaticResource ChartFill}}"
                                              Opacity="0.15">
                                            <Path.Fill>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#00FFFF" Offset="0"/>
                                                    <GradientStop Color="Transparent" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Path.Fill>
                                        </Path>
                                        <Path Data="{Binding CpuHistory, Converter={StaticResource ChartLine}}"
                                              Stroke="#00FFFF" StrokeThickness="1.5">
                                            <Path.Effect>
                                                <DropShadowEffect Color="#00FFFF" BlurRadius="4" ShadowDepth="0" Opacity="0.4"/>
                                            </Path.Effect>
                                        </Path>
                                    </Canvas>
                                </Viewbox>
                            </DockPanel>
                        </Border>

                        <!-- RAM Chart -->
                        <Border Grid.Column="2" Style="{StaticResource CardPanel}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="MEMORY USAGE HISTORY"
                                           Style="{StaticResource LabelText}" Margin="0,0,0,8"/>
                                <Viewbox Stretch="Fill">
                                    <Canvas Width="400" Height="80" ClipToBounds="True">
                                        <Path Data="{Binding RamHistory, Converter={StaticResource ChartFill}}"
                                              Opacity="0.15">
                                            <Path.Fill>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#00FF88" Offset="0"/>
                                                    <GradientStop Color="Transparent" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Path.Fill>
                                        </Path>
                                        <Path Data="{Binding RamHistory, Converter={StaticResource ChartLine}}"
                                              Stroke="#00FF88" StrokeThickness="1.5">
                                            <Path.Effect>
                                                <DropShadowEffect Color="#00FF88" BlurRadius="4" ShadowDepth="0" Opacity="0.4"/>
                                            </Path.Effect>
                                        </Path>
                                    </Canvas>
                                </Viewbox>
                            </DockPanel>
                        </Border>
                    </Grid>

                    <!-- ═══════ BOTTOM STATUS BAR ═══════ -->
                    <Border Grid.Row="3" Margin="0,20,0,0" Padding="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Decorative Top Border Line with cyan accent -->
                            <Canvas Grid.Row="0" Height="2" HorizontalAlignment="Stretch" Margin="0,0,0,0">
                                <Canvas.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="Transparent" Offset="0.0"/>
                                        <GradientStop Color="#4000FFFF" Offset="0.15"/>
                                        <GradientStop Color="#00FFFF" Offset="0.5"/>
                                        <GradientStop Color="#4000FFFF" Offset="0.85"/>
                                        <GradientStop Color="Transparent" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Canvas.Background>
                            </Canvas>

                            <!-- Status Bar Content -->
                            <Border Grid.Row="1" Padding="16,12" CornerRadius="0,0,4,4">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#0CFFFFFF" Offset="0"/>
                                        <GradientStop Color="#04FFFFFF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Shield Icon in bordered glowing container -->
                                    <Border Grid.Column="0" Width="38" Height="38"
                                            CornerRadius="6" Margin="0,0,14,0"
                                            BorderThickness="1.5" VerticalAlignment="Center">
                                        <Border.BorderBrush>
                                            <SolidColorBrush Color="#5000FFFF"/>
                                        </Border.BorderBrush>
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#10003333" Offset="0"/>
                                                <GradientStop Color="#1800FFFF" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <Border.Effect>
                                            <DropShadowEffect Color="#00FFFF" BlurRadius="12" ShadowDepth="0" Opacity="0.35"/>
                                        </Border.Effect>
                                        <TextBlock Text="🛡" FontSize="18"
                                                   Foreground="{StaticResource CyanBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- Status Text -->
                                    <TextBlock Grid.Column="1" Text="{Binding StatusText}"
                                               FontFamily="Consolas" FontSize="14" FontWeight="Bold"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               VerticalAlignment="Center">
                                        <TextBlock.Effect>
                                            <DropShadowEffect Color="#00FFFF" BlurRadius="6" ShadowDepth="0" Opacity="0.2"/>
                                        </TextBlock.Effect>
                                    </TextBlock>

                                    <!-- Scanning Pulse Indicator -->
                                    <Border x:Name="ScanPulse" Grid.Column="2" Width="8" Height="8"
                                            CornerRadius="4" Margin="0,0,16,0"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding IsScanning, Converter={StaticResource BoolVis}}">
                                        <Border.Background>
                                            <SolidColorBrush Color="#00FFFF"/>
                                        </Border.Background>
                                        <Border.Triggers>
                                            <EventTrigger RoutedEvent="Loaded">
                                                <BeginStoryboard>
                                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                         From="0.3" To="1.0" Duration="0:0:0.6">
                                                            <DoubleAnimation.EasingFunction>
                                                                <CubicEase EasingMode="EaseInOut"/>
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </Border.Triggers>
                                    </Border>

                                    <!-- Scan Button — neon cyan glow -->
                                    <Border Grid.Column="3" CornerRadius="4" Margin="0,0,12,0">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#00FFFF" BlurRadius="18" ShadowDepth="0" Opacity="0.5"/>
                                        </Border.Effect>
                                        <Button Content="{Binding ScanButtonText}"
                                                Style="{StaticResource CyberButton}"
                                                Command="{Binding ScanNowCommand}"/>
                                    </Border>

                                    <!-- Purge Button — neon magenta glow -->
                                    <Border Grid.Column="4" CornerRadius="4">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#FF00FF" BlurRadius="18" ShadowDepth="0" Opacity="0.5"/>
                                        </Border.Effect>
                                        <Button Content="☠ PURGE" Style="{StaticResource PurgeButton}"
                                                Command="{Binding PurgeThreatsCommand}"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ═══════ VIEW 1: THREATS ═══════ -->
                <Grid Visibility="{Binding ActiveView, Converter={StaticResource ViewVis}, ConverterParameter=1}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <TextBlock Text="⚠ ACTIVE THREATS" Style="{StaticResource HeaderText}"/>
                        <TextBlock Text="{Binding ThreatCount, StringFormat=' — {0} flagged'}"
                                   Style="{StaticResource SubHeaderText}" VerticalAlignment="Bottom" Margin="12,0,0,2"/>
                    </StackPanel>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding Threats}"
                              Style="{StaticResource CyberDataGrid}"
                              ColumnHeaderStyle="{StaticResource CyberColumnHeader}"
                              RowStyle="{StaticResource CyberDataGridRow}"
                              CellStyle="{StaticResource CyberDataGridCell}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="LEVEL" Width="120"
                                Binding="{Binding Score.Level, Converter={StaticResource ThreatString}}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{Binding Score.Level, Converter={StaticResource ThreatBrush}}"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="SCORE" Width="70"
                                Binding="{Binding Score, Converter={StaticResource ScoreString}}"/>
                            <DataGridTextColumn Header="PROCESS" Width="150"
                                Binding="{Binding Process.Name}"/>
                            <DataGridTextColumn Header="PID" Width="70"
                                Binding="{Binding Process.Pid}"/>
                            <DataGridTextColumn Header="PATH" Width="*"
                                Binding="{Binding Process.FilePath}"/>
                            <DataGridTextColumn Header="ACTION" Width="130"
                                Binding="{Binding RecommendedAction}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource MagentaBrush}"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <!-- ═══════ VIEW 2: PROCESSES ═══════ -->
                <Grid Visibility="{Binding ActiveView, Converter={StaticResource ViewVis}, ConverterParameter=2}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <TextBlock Text="◎ PROCESS EXPLORER" Style="{StaticResource HeaderText}"/>
                        <TextBlock Text="{Binding ProcessCount, StringFormat=' — {0} running'}"
                                   Style="{StaticResource SubHeaderText}" VerticalAlignment="Bottom" Margin="12,0,0,2"/>
                    </StackPanel>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding Processes}"
                              Style="{StaticResource CyberDataGrid}"
                              ColumnHeaderStyle="{StaticResource CyberColumnHeader}"
                              RowStyle="{StaticResource CyberDataGridRow}"
                              CellStyle="{StaticResource CyberDataGridCell}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="THREAT" Width="110"
                                Binding="{Binding Score.Level, Converter={StaticResource ThreatString}}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{Binding Score.Level, Converter={StaticResource ThreatBrush}}"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="NAME" Width="160"
                                Binding="{Binding Name}"/>
                            <DataGridTextColumn Header="PID" Width="70"
                                Binding="{Binding Pid}"/>
                            <DataGridTextColumn Header="MEM (MB)" Width="90"
                                Binding="{Binding MemoryMB, StringFormat={}{0:F1}}"/>
                            <DataGridTextColumn Header="THREADS" Width="80"
                                Binding="{Binding ThreadCount}"/>
                            <DataGridTextColumn Header="PARENT" Width="120"
                                Binding="{Binding ParentName}"/>
                            <DataGridTextColumn Header="PATH" Width="*"
                                Binding="{Binding FilePath}"/>
                            <DataGridTemplateColumn Header="ACTION" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="KILL" Style="{StaticResource DangerButton}"
                                                Padding="8,3" FontSize="10"
                                                Command="{Binding DataContext.KillProcessCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding Pid}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <!-- ═══════ VIEW 3: NETWORK ═══════ -->
                <Grid Visibility="{Binding ActiveView, Converter={StaticResource ViewVis}, ConverterParameter=3}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <TextBlock Text="⇄ NETWORK MONITOR" Style="{StaticResource HeaderText}"/>
                        <TextBlock Text="{Binding ConnectionCount, StringFormat=' — {0} connections'}"
                                   Style="{StaticResource SubHeaderText}" VerticalAlignment="Bottom" Margin="12,0,0,2"/>
                        <TextBlock Foreground="{StaticResource DangerBrush}" VerticalAlignment="Bottom" Margin="12,0,0,2"
                                   FontFamily="Consolas" FontSize="13" FontWeight="Bold">
                            <TextBlock.Text>
                                <Binding Path="SuspiciousConnectionCount" StringFormat="({0} suspicious)"/>
                            </TextBlock.Text>
                        </TextBlock>
                    </StackPanel>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding Connections}"
                              Style="{StaticResource CyberDataGrid}"
                              ColumnHeaderStyle="{StaticResource CyberColumnHeader}"
                              RowStyle="{StaticResource CyberDataGridRow}"
                              CellStyle="{StaticResource CyberDataGridCell}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="STATUS" Width="100"
                                Binding="{Binding State}"/>
                            <DataGridTextColumn Header="LOCAL" Width="200"
                                Binding="{Binding LocalEndpoint}"/>
                            <DataGridTextColumn Header="REMOTE" Width="200"
                                Binding="{Binding RemoteEndpoint}"/>
                            <DataGridTextColumn Header="PORT" Width="80"
                                Binding="{Binding RemotePort}"/>
                            <DataGridTextColumn Header="FLAG" Width="*"
                                Binding="{Binding SuspiciousReason}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <!-- ═══════ VIEW 4: LOGS ═══════ -->
                <Grid Visibility="{Binding ActiveView, Converter={StaticResource ViewVis}, ConverterParameter=4}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="▤ SYSTEM LOGS" Style="{StaticResource HeaderText}" Margin="0,0,0,16"/>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding Logs}"
                              Style="{StaticResource CyberDataGrid}"
                              ColumnHeaderStyle="{StaticResource CyberColumnHeader}"
                              RowStyle="{StaticResource CyberDataGridRow}"
                              CellStyle="{StaticResource CyberDataGridCell}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="TIME" Width="160"
                                Binding="{Binding Timestamp, StringFormat={}{0:HH:mm:ss.fff}}"/>
                            <DataGridTextColumn Header="LEVEL" Width="90"
                                Binding="{Binding Level}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{Binding Level, Converter={StaticResource LogBrush}}"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="SOURCE" Width="140"
                                Binding="{Binding Source}"/>
                            <DataGridTextColumn Header="MESSAGE" Width="*"
                                Binding="{Binding Message}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

            </Grid>
        </Grid>
    </Grid>
</Window>
