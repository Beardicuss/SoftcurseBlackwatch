<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════════════════════════════════════════ -->
    <!-- SOFTCURSE SENTINEL — CYBERPUNK THEME v2    -->
    <!-- ═══════════════════════════════════════════ -->

    <!-- Color Palette -->
    <Color x:Key="BackgroundColor">#020202</Color>
    <Color x:Key="SurfaceColor">#0A0A0A</Color>
    <Color x:Key="CardColor">#06080C</Color>
    <Color x:Key="BorderColor">#1A3A3A</Color>
    <Color x:Key="CyanAccent">#00FFFF</Color>
    <Color x:Key="NeonBlue">#0088FF</Color>
    <Color x:Key="Magenta">#FF00FF</Color>
    <Color x:Key="TextPrimary">#E0FFFF</Color>
    <Color x:Key="TextSecondary">#6FAAAA</Color>
    <Color x:Key="DangerRed">#FF2244</Color>
    <Color x:Key="WarningOrange">#FF8800</Color>
    <Color x:Key="SafeGreen">#00FF88</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="CyanBrush" Color="{StaticResource CyanAccent}"/>
    <SolidColorBrush x:Key="NeonBlueBrush" Color="{StaticResource NeonBlue}"/>
    <SolidColorBrush x:Key="MagentaBrush" Color="{StaticResource Magenta}"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerRed}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningOrange}"/>
    <SolidColorBrush x:Key="SafeBrush" Color="{StaticResource SafeGreen}"/>

    <!-- Glassmorphism -->
    <!-- Glassy: very transparent, frosted look -->
    <LinearGradientBrush x:Key="GlassBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#0CFFFFFF" Offset="0"/>
        <GradientStop Color="#04FFFFFF" Offset="0.5"/>
        <GradientStop Color="#08FFFFFF" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="CyanGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#00FFFF" Offset="0"/>
        <GradientStop Color="#0088FF" Offset="1"/>
    </LinearGradientBrush>

    <!-- Card Border Brushes — Glowing -->
    <SolidColorBrush x:Key="CardBorderCyan" Color="#4500FFFF"/>
    <SolidColorBrush x:Key="CardBorderMagenta" Color="#50FF00FF"/>

    <!-- Glow Effects -->
    <DropShadowEffect x:Key="CyanGlow" Color="#00FFFF" BlurRadius="15" ShadowDepth="0" Opacity="0.6"/>
    <DropShadowEffect x:Key="CyanGlowStrong" Color="#00FFFF" BlurRadius="25" ShadowDepth="0" Opacity="0.8"/>
    <DropShadowEffect x:Key="CyanGlowSubtle" Color="#00FFFF" BlurRadius="8" ShadowDepth="0" Opacity="0.35"/>
    <DropShadowEffect x:Key="MagentaGlow" Color="#FF00FF" BlurRadius="15" ShadowDepth="0" Opacity="0.5"/>
    <DropShadowEffect x:Key="MagentaGlowSubtle" Color="#FF00FF" BlurRadius="8" ShadowDepth="0" Opacity="0.3"/>

    <!-- ═══════ BUTTON ═══════ -->
    <Style x:Key="CyberButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource CyanBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource CyanBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="20,10"/>
        <Setter Property="FontFamily" Value="Consolas"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3" Padding="{TemplateBinding Padding}"
                            Effect="{StaticResource CyanGlowSubtle}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#2000FFFF"/>
                            <Setter TargetName="Bd" Property="Effect" Value="{StaticResource CyanGlow}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#4000FFFF"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Danger Button -->
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource CyberButton}">
        <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent"
                            BorderBrush="{StaticResource DangerBrush}" BorderThickness="1"
                            CornerRadius="3" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#30FF2244"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#50FF2244"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Magenta Purge Button -->
    <Style x:Key="PurgeButton" TargetType="Button" BasedOn="{StaticResource CyberButton}">
        <Setter Property="Foreground" Value="{StaticResource MagentaBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource MagentaBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent"
                            BorderBrush="{StaticResource MagentaBrush}" BorderThickness="1.5"
                            CornerRadius="3" Padding="{TemplateBinding Padding}"
                            Effect="{StaticResource MagentaGlowSubtle}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#30FF00FF"/>
                            <Setter TargetName="Bd" Property="Effect" Value="{StaticResource MagentaGlow}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#50FF00FF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════ NAV BUTTON ═══════ -->
    <Style x:Key="NavButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="20,12"/>
        <Setter Property="FontFamily" Value="Consolas"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Indicator" Width="3" Background="Transparent"
                                    VerticalAlignment="Stretch" HorizontalAlignment="Left"/>
                            <ContentPresenter Grid.Column="1" Margin="10,0,0,0"
                                              HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#1000FFFF"/>
                            <Setter Property="Foreground" Value="{StaticResource CyanBrush}"/>
                        </Trigger>
                        <Trigger Property="Tag" Value="Active">
                            <Setter TargetName="Bd" Property="Background" Value="#1800FFFF"/>
                            <Setter TargetName="Indicator" Property="Background" Value="{StaticResource CyanBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource CyanBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════ CARD — with glowing cyan border ═══════ -->
    <Style x:Key="CardPanel" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource GlassBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource CardBorderCyan}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="16"/>
    </Style>

    <!-- Card with Magenta accent (for Threats) -->
    <Style x:Key="CardPanelMagenta" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource GlassBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource CardBorderMagenta}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="16"/>
    </Style>

    <!-- ═══════ STATUS BAR ═══════ -->
    <Style x:Key="StatusBarPanel" TargetType="Border">
        <Setter Property="Background" Value="#08FFFFFF"/>
        <Setter Property="BorderThickness" Value="0,1,0,0"/>
        <Setter Property="BorderBrush" Value="{StaticResource CardBorderCyan}"/>
        <Setter Property="Padding" Value="20,10"/>
    </Style>

    <!-- ═══════ DATAGRID ═══════ -->
    <Style x:Key="CyberDataGrid" TargetType="DataGrid">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource CardBorderCyan}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="RowBackground" Value="Transparent"/>
        <Setter Property="AlternatingRowBackground" Value="#08FFFFFF"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush" Value="#1500FFFF"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="SelectionMode" Value="Single"/>
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="CanUserDeleteRows" Value="False"/>
        <Setter Property="FontFamily" Value="Consolas"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="IsReadOnly" Value="True"/>
    </Style>

    <Style x:Key="CyberColumnHeader" TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="#15003333"/>
        <Setter Property="Foreground" Value="{StaticResource CyanBrush}"/>
        <Setter Property="FontFamily" Value="Consolas"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
    </Style>

    <Style x:Key="CyberDataGridRow" TargetType="DataGridRow">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="#2500FFFF"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#1500FFFF"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="CyberDataGridCell" TargetType="DataGridCell">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="6,4"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{StaticResource CyanBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ═══════ TEXTBLOCK STYLES ═══════ -->
    <Style x:Key="HeaderText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource CyanBrush}"/>
        <Setter Property="FontFamily" Value="Consolas"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Effect" Value="{StaticResource CyanGlowSubtle}"/>
    </Style>

    <Style x:Key="SubHeaderText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="FontFamily" Value="Consolas"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="ValueText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource CyanBrush}"/>
        <Setter Property="FontFamily" Value="Consolas"/>
        <Setter Property="FontSize" Value="28"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <Style x:Key="LabelText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="FontFamily" Value="Consolas"/>
        <Setter Property="FontSize" Value="11"/>
    </Style>

    <!-- ═══════ PROGRESSBAR — Cyan ═══════ -->
    <Style x:Key="CyberProgressBar" TargetType="ProgressBar">
        <Setter Property="Height" Value="6"/>
        <Setter Property="Background" Value="#15003333"/>
        <Setter Property="Foreground" Value="{StaticResource CyanBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border Background="{TemplateBinding Background}" CornerRadius="3"/>
                        <Border x:Name="PART_Track" CornerRadius="3"/>
                        <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="3">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#00FFFF" Offset="0"/>
                                    <GradientStop Color="#0088FF" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════ PROGRESSBAR — Magenta (for threats card) ═══════ -->
    <Style x:Key="MagentaProgressBar" TargetType="ProgressBar">
        <Setter Property="Height" Value="6"/>
        <Setter Property="Background" Value="#15330033"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border Background="{TemplateBinding Background}" CornerRadius="3"/>
                        <Border x:Name="PART_Track" CornerRadius="3"/>
                        <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="3">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#FF00FF" Offset="0"/>
                                    <GradientStop Color="#FF4488" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════ SCROLLBAR ═══════ -->
    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="8"/>
    </Style>

</ResourceDictionary>
